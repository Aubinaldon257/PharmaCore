# Copier ce fichier vers .env puis renseigner les identifiants fournis par le service SMTP.
PHARMACORE_SMTP_HOST=
PHARMACORE_SMTP_PORT=587
PHARMACORE_SMTP_USERNAME=
PHARMACORE_SMTP_PASSWORD=
# tls pour le port 587 ou ssl pour le port 465.
PHARMACORE_SMTP_ENCRYPTION=tls
PHARMACORE_MAIL_FROM=
PHARMACORE_MAIL_FROM_NAME=PharmaCore
# URL accessible aux utilisateurs qui recevront le lien.
PHARMACORE_BASE_URL=http://localhost/pharmacore
